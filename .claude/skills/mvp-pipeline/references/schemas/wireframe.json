{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screenName": {
            "type": "string",
            "description": "画面名（日本語。ナビのメニュー名に対応）"
          },
          "targetObject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "この画面が扱う OOUI オブジェクト名（日本語。ナビの targetObject と一致させる。横断ダッシュボード等は空可）"
          },
          "screenType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "画面種別（dashboard/list/detail/form など）"
          },
          "layoutPattern": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "stack",
                  "master-detail",
                  "grid",
                  "single"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "レイアウト配置パターン。stack=画面遷移(コレクション→シングルを画面切替), master-detail=2ペイン(左コレクション→右シングル同時表示), grid=ダッシュボード等の集約グリッド, single=フォーム等の単一ビュー"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "header",
                    "toolbar",
                    "kpi",
                    "chart",
                    "table",
                    "list",
                    "cards",
                    "calendar",
                    "map",
                    "timeline",
                    "form",
                    "detail",
                    "sidebar",
                    "footer",
                    "other"
                  ],
                  "description": "セクション種別。コレクションの表示形式はオブジェクトの性質で選ぶ（table/cards/calendar/map/timeline 等）"
                },
                "label": {
                  "type": "string",
                  "description": "セクションの見出し/説明（日本語）"
                },
                "items": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "主要要素（カラム名/ボタン/項目など・日本語）"
                }
              },
              "required": [
                "type",
                "label",
                "items"
              ],
              "additionalProperties": false
            },
            "description": "画面を構成するセクション（上から順）"
          }
        },
        "required": [
          "screenName",
          "targetObject",
          "screenType",
          "layoutPattern",
          "sections"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "screens"
  ],
  "additionalProperties": false
}
